; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Reference",
"class": "SVGAParser",
"language": "GDScript",
"path": "res://addons/SVGAPlayer-Godot/player/svga_parser.gd"
}, {
"base": "Node2D",
"class": "SVGAPlayer",
"language": "GDScript",
"path": "res://addons/SVGAPlayer-Godot/player/svga_player.gd"
}, {
"base": "Reference",
"class": "SVGARender",
"language": "GDScript",
"path": "res://addons/SVGAPlayer-Godot/player/svga_render.gd"
}, {
"base": "Reference",
"class": "SVGASpriteFrame",
"language": "GDScript",
"path": "res://addons/SVGAPlayer-Godot/player/svga_sprite_frame.gd"
} ]
_global_script_class_icons={
"SVGAParser": "",
"SVGAPlayer": "",
"SVGARender": "",
"SVGASpriteFrame": ""
}

[application]

config/name="SVGAPlayer-Godot"
run/main_scene="res://addons/SVGAPlayer-Godot/example/Main.tscn"
config/icon="res://icon.png"

[editor_plugins]

enabled=PoolStringArray(  )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_environment="res://default_env.tres"
